# Production environment variables — loaded by Vite at build time.
# These are NOT secrets: appId and appBaseUrl are public identifiers
# visible in every API request the app makes. They must be baked into
# the Tauri binary so the Base44 SDK knows which backend app to talk to.
#
# Without them, appParams.appId is null and every API call (auth,
# entities, functions) returns 404 in the compiled desktop app.
VITE_BASE44_APP_ID=69e14a987a927963a9924d5a
VITE_BASE44_APP_BASE_URL=https://matrix-hub.base44.app