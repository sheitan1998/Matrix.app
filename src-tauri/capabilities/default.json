{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the Matrix main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-webview-url",
    "core:webview:allow-set-webview-url",
    "core:webview:allow-webview-by-label",
    "core:webview:allow-internal-toggle-devtools",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-get-window-by-label",
    "core:window:allow-set-title",
    "core:window:allow-center",
    "core:window:allow-show",
    "core:window:allow-hide",
    "updater:default",
    "deep-link:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" }
      ]
    },
    {
      "identifier": "allow-open-auth-window",
      "description": "Allow the open_auth_window command to open OAuth URLs in the system browser",
      "commands": {
        "allow": ["open_auth_window"]
      }
    },
    {
      "identifier": "allow-handle-oauth-callback",
      "description": "Allow the handle_oauth_callback command to validate OAuth callback data",
      "commands": {
        "allow": ["handle_oauth_callback"]
      }
    },
    {
      "identifier": "allow-check-for-updates",
      "description": "Allow the check_for_updates command",
      "commands": {
        "allow": ["check_for_updates"]
      }
    },
    {
      "identifier": "allow-install-update",
      "description": "Allow the install_update command",
      "commands": {
        "allow": ["install_update"]
      }
    },
    {
      "identifier": "allow-get-current-version",
      "description": "Allow the get_current_version command",
      "commands": {
        "allow": ["get_current_version"]
      }
    }
  ]
}