{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matrix",
  "version": "1.0.2",
  "identifier": "com.matrix.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Matrix",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "webviewAttributes": {
          "autoplay": true
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:1420 http://127.0.0.1:1420; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420; style-src 'self' 'unsafe-inline' http://localhost:1420; img-src 'self' data: https: http:; font-src 'self' data: https:; connect-src 'self' http://localhost:1420 http://127.0.0.1:1420 https: http: ws: wss:; frame-src 'self' https:; child-src 'self' https:; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "category": "Entertainment",
    "shortDescription": "Matrix, plateforme vidéo et communautaire",
    "longDescription": "Matrix rassemble streaming vidéo, communauté, casino et outils créatifs.",
    "nsis": {
      "artifactPath": null,
      "certificatePath": null,
      "certificatePassword": null,
      "signingIdentity": null,
      "timestampUrl": null,
      "preInstallerScript": null,
      "installerHooks": null,
      "installersPath": null,
      "license": null,
      "languages": null,
      "customNsisScript": null,
      "headerImage": null,
      "sidebarImage": null,
      "installerIcon": null,
      "uninstallerIcon": null,
      "displayLanguageSelector": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcuts": true,
      "startMenuShortcuts": ["NSIS_SHORTCUTS_APP"],
      "shortcutLanguages": []
    },
    "windows": [
      {
        "certificatePath": null,
        "certificatePassword": null,
        "signingIdentity": null,
        "timestampUrl": null,
        "tsp": false,
        "sign": []
      }
    ]
  }
}
