{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matrix",
  "version": "1.0.2",
  "identifier": "com.matrix.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Matrix",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Multimedia",
    "shortDescription": "Matrix, plateforme vidéo et communautaire",
    "longDescription": "Matrix rassemble streaming vidéo, communauté, casino et outils créatifs."
  }
}