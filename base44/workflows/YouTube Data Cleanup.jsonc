{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "YouTube Data Cleanup",
  "description": "Supprime les donn\u00e9es YouTube API (vid\u00e9os/cha\u00eenes en cache) de plus de 30 jours \u2014 conformit\u00e9 YouTube API Services",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "youtube_data_cleanup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "cleanup_youtube_data": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "youtubeCleanup",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Nettoyage donn\u00e9es YouTube",
            "description": "Supprime les donn\u00e9es API > 30 jours"
          }
        }
      }
    ]
  }
}