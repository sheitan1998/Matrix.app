{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hourly_vote_auto_processor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_auto_votes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "serverSearch",
            "args": {
              "action": "processAutoVotes"
            }
          },
          "then": "process_creator_auto_votes",
          "x-base44": {
            "title": "Traiter les votes automatiques",
            "description": "Vote Auto pour chaque abonn\u00e9 actif"
          }
        }
      },
      {
        "process_creator_auto_votes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "creatorSearch",
            "args": {
              "action": "processAutoVotes"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Traiter le Vote Auto des cr\u00e9ateurs",
            "description": "Cha\u00eenes YouTube et Twitch s\u00e9lectionn\u00e9es"
          }
        }
      }
    ]
  },
  "description": "Traite tous les votes automatiques des abonn\u00e9s Vote Auto (4,99\u20ac/mois) - serveurs et cha\u00eenes Best Creator, 1h avec VIP, 2h sinon",
  "name": "Hourly Vote Auto Processor",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}