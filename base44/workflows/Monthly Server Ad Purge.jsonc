{
  "name": "Monthly Server Ad Purge",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_server_ad_purge",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "purge_ads": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "serverSearch",
            "args": {
              "action": "monthlyPurge"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Purge mensuelle des annonces",
            "description": "Supprime toutes les annonces de serveurs"
          }
        }
      }
    ]
  },
  "description": "Supprime automatiquement toutes les annonces de serveurs le 1er de chaque mois",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}