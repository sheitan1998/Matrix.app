{
  "name": "Monthly Server Ad Purge",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_server_ad_purge",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "reset_monthly": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "serverSearch",
            "args": {
              "action": "resetMonthly"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Reset mensuel des votes et boosts",
            "description": "Remet a zero les votes et boosts de tous les serveurs"
          }
        }
      }
    ]
  },
  "description": "Remet a zero les votes et boosts de tous les serveurs le 1er de chaque mois",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}