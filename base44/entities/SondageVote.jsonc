{
  "name": "SondageVote",
  "type": "object",
  "properties": {
    "sondage_id": {
      "type": "string",
      "description": "ID du sondage"
    },
    "choice_id": {
      "type": "string",
      "description": "ID du choix vote"
    },
    "user_email": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "sondage_id",
    "choice_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}