{
  "name": "ServerBoostRecord",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string",
      "description": "ID du serveur boost\u00e9"
    },
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur qui a boost\u00e9"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'expiration du boost (now + 30 jours)"
    }
  },
  "required": [
    "server_id",
    "user_email",
    "expires_at"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}