{
  "name": "FortniteConfig",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Epic Games Product ID"
    },
    "application_id": {
      "type": "string",
      "description": "Epic Games Application ID"
    },
    "sandbox_id": {
      "type": "string",
      "description": "Epic Games Sandbox (Deployment) ID"
    },
    "client_id": {
      "type": "string",
      "description": "Epic Games EOS Client ID"
    },
    "client_secret": {
      "type": "string",
      "description": "Epic Games EOS Client Secret"
    },
    "fortnite_api_key": {
      "type": "string",
      "description": "Cl\u00e9 API fortnite-api.com (gratuite) pour les statistiques joueurs"
    },
    "cache_ttl_minutes": {
      "type": "number",
      "default": 12,
      "description": "Dur\u00e9e du cache serveur en minutes (10-15 recommand\u00e9)"
    },
    "sync_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Activer la synchronisation automatique des metrics"
    },
    "show_api_maps": {
      "type": "boolean",
      "default": true,
      "description": "Afficher les cartes populaires UEFN/Cr\u00e9atif depuis l'API fortnite-api.com"
    },
    "show_daily_shop": {
      "type": "boolean",
      "default": true,
      "description": "Afficher la boutique du jour (Shop BR) sur la page Fortnite Maps"
    },
    "show_cosmetics": {
      "type": "boolean",
      "default": true,
      "description": "Afficher la recherche de cosm\u00e9tiques (skins, pioches, sacs, emotes)"
    },
    "show_player_stats": {
      "type": "boolean",
      "default": true,
      "description": "Afficher le bloc de recherche de statistiques joueur"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re synchronisation des metrics API"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "client_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}