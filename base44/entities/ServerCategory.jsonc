{
  "name": "ServerCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de la categorie/jeu"
    },
    "slug": {
      "type": "string",
      "description": "Slug URL unique"
    },
    "type": {
      "type": "string",
      "enum": [
        "nexus",
        "discord"
      ],
      "description": "Type de serveurs: nexus ou discord"
    },
    "image_url": {
      "type": "string",
      "description": "URL de l'image de fond de la categorie"
    },
    "badge": {
      "type": "string",
      "enum": [
        "POPULAIRE",
        "NEW",
        "TENDANCE",
        "HOT",
        ""
      ],
      "default": "",
      "description": "Badge affiche sur la carte"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "slug",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}