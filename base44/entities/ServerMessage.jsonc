{
  "name": "ServerMessage",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string"
    },
    "channel_id": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "system",
        "file",
        "voice"
      ],
      "default": "text"
    },
    "effect": {
      "type": "string",
      "enum": [
        "none",
        "glow",
        "rainbow",
        "fire",
        "sparkle",
        "pulse",
        "shake"
      ],
      "default": "none",
      "description": "Effet visuel applique au message (Boost Niveau 2+)"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string",
      "description": "Nom du fichier joint"
    },
    "transcript": {
      "type": "string",
      "description": "Transcription automatique du message vocal (generee localement via Web Speech API)"
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "emoji": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Reactions des utilisateurs sur ce message"
    },
    "reply_to_id": {
      "type": "string",
      "description": "ID du message auquel on repond (optionnel)"
    },
    "reply_to_name": {
      "type": "string",
      "description": "Nom de l'auteur du message repondu (pour apercu)"
    },
    "reply_to_content": {
      "type": "string",
      "description": "Apercu du contenu du message repondu"
    },
    "is_thread_starter": {
      "type": "boolean",
      "default": false,
      "description": "Indique si ce message est le premier d'une discussion (forum)"
    },
    "thread_title": {
      "type": "string",
      "description": "Titre de la discussion (forum)"
    },
    "thread_replies": {
      "type": "number",
      "default": 0,
      "description": "Nombre de reponses dans la discussion"
    },
    "thread_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Discussion epinglee dans le forum"
    }
  },
  "required": [
    "server_id",
    "channel_id",
    "author_email",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}