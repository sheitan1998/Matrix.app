{
  "name": "AffiliatePartner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du partenaire"
    },
    "title": {
      "type": "string",
      "description": "Titre affich\u00e9 sur la carte"
    },
    "btn": {
      "type": "string",
      "description": "Libelle du bouton"
    },
    "href": {
      "type": "string",
      "description": "URL du lien d'affiliation"
    },
    "image": {
      "type": "string",
      "description": "URL de l'image du partenaire"
    },
    "extra_search": {
      "type": "boolean",
      "default": false,
      "description": "Afficher l'icone de recherche supplementaire"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "title",
    "href"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}