{
  "name": "User",
  "type": "object",
  "properties": {
    "trix_balance": {
      "type": "number",
      "default": 0,
      "description": "Current TRIX coin balance"
    },
    "flash_boosts": {
      "type": "number",
      "default": 0,
      "description": "Flash boosts available for boosting servers"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Premium subscription - no ads"
    },
    "premium_until": {
      "type": "string",
      "format": "date-time"
    },
    "is_vip": {
      "type": "boolean",
      "default": false,
      "description": "VIP subscription status"
    },
    "vip_until": {
      "type": "string",
      "format": "date-time",
      "description": "VIP subscription expiration date"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID for billing portal"
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "count": {
            "type": "number",
            "default": 1
          },
          "purchased_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "User inventory of purchased items"
    },
    "avatar_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "channel_id": {
      "type": "string",
      "description": "Associated channel if creator"
    },
    "pseudo": {
      "type": "string",
      "description": "Pseudo de l'utilisateur (partie avant le #)"
    },
    "pseudo_tag": {
      "type": "string",
      "description": "Tag unique a 4 chiffres (partie apres le #)"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Derniere fois que l'utilisateur etait actif"
    },
    "current_activity": {
      "type": "string",
      "description": "Activite en cours de l'utilisateur (ex: Joue au Casino, Regarde des Shorts)"
    },
    "current_activity_type": {
      "type": "string",
      "enum": [
        "gaming",
        "streaming",
        "browsing",
        "creating",
        "social",
        "shopping",
        "idle"
      ],
      "default": "idle",
      "description": "Categorie d'activite pour l'affichage d'icone"
    },
    "is_muted": {
      "type": "boolean",
      "default": false,
      "description": "User is muted (cannot send messages)"
    },
    "is_banned": {
      "type": "boolean",
      "default": false,
      "description": "User is banned (cannot access app)"
    },
    "mute_reason": {
      "type": "string",
      "description": "Reason for muting"
    },
    "ban_reason": {
      "type": "string",
      "description": "Reason for banning"
    },
    "muted_until": {
      "type": "string",
      "format": "date-time",
      "description": "Mute expiration date"
    },
    "banned_until": {
      "type": "string",
      "format": "date-time",
      "description": "Ban expiration date"
    }
  },
  "required": [
    "premium_until",
    "avatar_url",
    "bio",
    "channel_id"
  ]
}