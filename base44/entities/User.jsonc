{
  "name": "User",
  "type": "object",
  "properties": {
    "trix_balance": {
      "type": "number",
      "default": 0,
      "description": "Current TRIX coin balance",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "flash_boosts": {
      "type": "number",
      "default": 0,
      "description": "Flash boosts available for boosting servers",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Premium subscription - no ads",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "premium_until": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_vip": {
      "type": "boolean",
      "default": false,
      "description": "VIP subscription status",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "vip_until": {
      "type": "string",
      "format": "date-time",
      "description": "VIP subscription expiration date",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID for billing portal",
      "rls": {
        "read": false,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "count": {
            "type": "number",
            "default": 1
          },
          "purchased_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "User inventory of purchased items",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string",
      "description": "URL de la banni\u00e8re de profil"
    },
    "bio": {
      "type": "string"
    },
    "channel_id": {
      "type": "string",
      "description": "Associated channel if creator"
    },
    "pseudo": {
      "type": "string",
      "description": "Pseudo de l'utilisateur (partie avant le #)"
    },
    "pseudo_tag": {
      "type": "string",
      "description": "Tag unique a 4 chiffres (partie apres le #)"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Derniere fois que l'utilisateur etait actif"
    },
    "current_activity": {
      "type": "string",
      "description": "Activite en cours de l'utilisateur (ex: Joue au Casino, Regarde des Shorts)"
    },
    "current_activity_type": {
      "type": "string",
      "enum": [
        "gaming",
        "streaming",
        "browsing",
        "creating",
        "social",
        "shopping",
        "idle",
        "custom"
      ],
      "default": "idle",
      "description": "Categorie d'activite pour l'affichage d'icone"
    },
    "custom_status": {
      "type": "string",
      "maxLength": 80,
      "description": "Statut personnalise defini par l'utilisateur (prioritaire sur la detection automatique)"
    },
    "show_game_activity": {
      "type": "boolean",
      "default": true,
      "description": "Afficher l'activite de jeu (Rich Presence) aux autres utilisateurs dans les serveurs et le profil"
    },
    "manual_game": {
      "type": "string",
      "maxLength": 80,
      "description": "Jeu defini manuellement par l'utilisateur (surcharge la detection automatique)"
    },
    "is_muted": {
      "type": "boolean",
      "default": false,
      "description": "User is muted (cannot send messages)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_banned": {
      "type": "boolean",
      "default": false,
      "description": "User is banned (cannot access app)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "mute_reason": {
      "type": "string",
      "description": "Reason for muting",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "ban_reason": {
      "type": "string",
      "description": "Reason for banning",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "muted_until": {
      "type": "string",
      "format": "date-time",
      "description": "Mute expiration date",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "banned_until": {
      "type": "string",
      "format": "date-time",
      "description": "Ban expiration date",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "notif_messages": {
      "type": "boolean",
      "default": true,
      "description": "Recevoir des notifications pour les messages"
    },
    "notif_free_rewards": {
      "type": "boolean",
      "default": true,
      "description": "Recevoir des rappels pour les recompenses gratuites (Roue de la Fortune, Ticket Quotidien)"
    },
    "allow_friend_requests": {
      "type": "boolean",
      "default": true,
      "description": "Autoriser les autres utilisateurs a ajouter l'utilisateur en ami"
    },
    "dm_privacy": {
      "type": "string",
      "enum": [
        "everyone",
        "friends"
      ],
      "default": "everyone",
      "description": "Qui peut envoyer des messages prives a l'utilisateur (everyone = tout le monde, friends = uniquement les amis)"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "description": "Profil prive \u2014 masque l'utilisateur des resultats de recherche publique (Prospecteur)"
    },
    "interface_language": {
      "type": "string",
      "enum": [
        "fr",
        "en",
        "es",
        "de",
        "it",
        "pt",
        "nl",
        "ru",
        "ja",
        "zh",
        "ar"
      ],
      "default": "fr",
      "description": "Langue d'affichage de l'interface Matrix"
    },
    "timezone": {
      "type": "string",
      "default": "UTC",
      "description": "Fuseau horaire de l'utilisateur (ex: Europe/Paris, America/New_York, UTC)"
    }
  },
  "required": []
}