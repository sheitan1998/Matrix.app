{
  "name": "User",
  "type": "object",
  "properties": {
    "trix_balance": {
      "type": "number",
      "default": 0,
      "description": "Current TRIX coin balance"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Premium subscription - no ads"
    },
    "premium_until": {
      "type": "string",
      "format": "date-time"
    },
    "avatar_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "channel_id": {
      "type": "string",
      "description": "Associated channel if creator"
    },
    "pseudo": {
      "type": "string",
      "description": "Pseudo de l'utilisateur (partie avant le #)"
    },
    "pseudo_tag": {
      "type": "string",
      "description": "Tag unique a 4 chiffres (partie apres le #)"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Derniere fois que l'utilisateur etait actif (pour presence temps reel)"
    }
  },
  "required": [
    "premium_until",
    "avatar_url",
    "bio",
    "channel_id"
  ]
}