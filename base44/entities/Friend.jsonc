{
  "name": "Friend",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the record owner (used for RLS access control)"
    },
    "friend_user_id": {
      "type": "string",
      "description": "Unique ID of the friend user (stable link to profiles table)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_sent",
        "pending_received",
        "accepted",
        "blocked"
      ],
      "default": "pending_sent"
    }
  },
  "required": [
    "user_email",
    "friend_user_id"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}