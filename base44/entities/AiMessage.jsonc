{
  "name": "AiMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID de la discussion AiConversation"
    },
    "user_id": {
      "type": "string",
      "description": "Identifiant du proprietaire (isolation stricte des messages)"
    },
    "user_email": {
      "type": "string",
      "description": "Email du proprietaire du message (affichage)"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "enumColors": [
        "purple",
        "green"
      ],
      "default": "user"
    },
    "content": {
      "type": "string",
      "description": "Contenu Markdown du message"
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "image"
      ],
      "default": "text",
      "description": "Type de message (texte ou image generee)"
    },
    "image_url": {
      "type": "string",
      "description": "URL de l'image generee par Matrix AI (kind = image)"
    },
    "attached_cards": {
      "type": "array",
      "default": [],
      "description": "Mini-cartes de recommandation (serveurs / createurs Matrix)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "votes": {
            "type": "number",
            "default": 0
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "conversation_id",
    "user_id",
    "role",
    "content"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}