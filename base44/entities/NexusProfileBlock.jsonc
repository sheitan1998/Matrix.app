{
  "name": "NexusProfileBlock",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Cl\u00e9 technique unique"
    },
    "name": {
      "type": "string",
      "description": "Nom affich\u00e9"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "block_type": {
      "type": "string",
      "enum": [
        "stats",
        "badges",
        "activity",
        "roles",
        "custom_status",
        "dm_input",
        "trophies",
        "friend_status",
        "report_button",
        "custom"
      ],
      "default": "stats",
      "description": "Type de bloc affich\u00e9 dans le pop-up de profil"
    },
    "is_visible": {
      "type": "boolean",
      "default": true,
      "description": "Bloc visible par d\u00e9faut dans les pop-ups de profil"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "key",
    "name",
    "block_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}