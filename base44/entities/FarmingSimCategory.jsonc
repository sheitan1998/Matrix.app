{
  "name": "FarmingSimCategory",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "Identifiant URL unique"
    },
    "parent_slug": {
      "type": "string",
      "description": "Slug de la categorie parente (null pour les categories principales)"
    },
    "img": {
      "type": "string",
      "description": "URL de l'image (capture d'ecran)"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "game_slug": {
      "type": "string",
      "default": "farming-simulator-25"
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}