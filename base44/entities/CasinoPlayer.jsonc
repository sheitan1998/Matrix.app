{
  "name": "CasinoPlayer",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "pseudo": {
      "type": "string",
      "description": "Pseudo du joueur pour le profil Nexus Game"
    },
    "balance": {
      "type": "number",
      "default": 5000
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "total_xp": {
      "type": "number",
      "default": 0
    },
    "total_bets": {
      "type": "number",
      "default": 0
    },
    "total_wagered": {
      "type": "number",
      "default": 0
    },
    "total_won": {
      "type": "number",
      "default": 0
    },
    "biggest_win": {
      "type": "number",
      "default": 0
    },
    "max_bet": {
      "type": "number",
      "default": 0
    },
    "jackpot_wins": {
      "type": "number",
      "default": 0
    },
    "won_24h": {
      "type": "number",
      "default": 0,
      "description": "Gains cumul\u00e9s des derni\u00e8res 24 heures"
    },
    "last_reset_24h": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re r\u00e9initialisation du compteur 24h"
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}