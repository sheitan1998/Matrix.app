{
  "name": "CasinoPlayer",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 5000
    },
    "total_bets": {
      "type": "number",
      "default": 0
    },
    "total_wagered": {
      "type": "number",
      "default": 0
    },
    "total_won": {
      "type": "number",
      "default": 0
    },
    "biggest_win": {
      "type": "number",
      "default": 0
    },
    "jackpot_wins": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}