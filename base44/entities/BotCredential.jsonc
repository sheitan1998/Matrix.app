{
  "name": "BotCredential",
  "type": "object",
  "properties": {
    "integration_id": {
      "type": "string",
      "description": "ID de la BotIntegration li\u00e9e"
    },
    "owner_email": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "twitch",
        "youtube"
      ],
      "enumColors": [
        "purple",
        "red"
      ]
    },
    "access_token": {
      "type": "string",
      "description": "Jeton d'acc\u00e8s \u2014 jamais renvoy\u00e9 au navigateur"
    },
    "refresh_token": {
      "type": "string",
      "description": "Jeton de renouvellement \u2014 jamais renvoy\u00e9 au navigateur"
    },
    "expires_at": {
      "type": "number",
      "description": "Expiration du jeton en millisecondes"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "integration_id",
    "owner_email",
    "platform"
  ],
  "rls": {
    "read": false,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}