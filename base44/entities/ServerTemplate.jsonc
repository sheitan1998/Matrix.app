{
  "name": "ServerTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de la configuration globale"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "voice",
              "announce",
              "forum",
              "category"
            ],
            "default": "text"
          },
          "topic": {
            "type": "string"
          },
          "is_nsfw": {
            "type": "boolean",
            "default": false
          },
          "slowmode_seconds": {
            "type": "number",
            "default": 0
          },
          "category_id": {
            "type": "string"
          },
          "permissions": {
            "type": "object",
            "properties": {
              "read": {
                "type": "string",
                "enum": [
                  "everyone",
                  "mods",
                  "admin"
                ],
                "default": "everyone"
              },
              "write": {
                "type": "string",
                "enum": [
                  "everyone",
                  "mods",
                  "admin"
                ],
                "default": "everyone"
              }
            },
            "default": {
              "read": "everyone",
              "write": "everyone"
            }
          },
          "settings": {
            "type": "object",
            "properties": {
              "visible": {
                "type": "boolean",
                "default": true
              },
              "send_messages": {
                "type": "boolean",
                "default": true
              },
              "embed_links": {
                "type": "boolean",
                "default": true
              },
              "add_reactions": {
                "type": "boolean",
                "default": true
              },
              "manage_messages": {
                "type": "boolean",
                "default": false
              },
              "read_history": {
                "type": "boolean",
                "default": true
              },
              "voice_connect": {
                "type": "boolean",
                "default": true
              },
              "voice_speak": {
                "type": "boolean",
                "default": true
              },
              "voice_move_members": {
                "type": "boolean",
                "default": false
              }
            },
            "default": {}
          }
        }
      },
      "default": []
    },
    "custom_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "permissions": {
            "type": "object",
            "properties": {
              "view_channels": {
                "type": "boolean",
                "default": true
              },
              "manage_channels": {
                "type": "boolean",
                "default": false
              },
              "manage_roles": {
                "type": "boolean",
                "default": false
              },
              "manage_emojis": {
                "type": "boolean",
                "default": false
              },
              "view_logs": {
                "type": "boolean",
                "default": false
              },
              "create_invite": {
                "type": "boolean",
                "default": true
              },
              "change_nicknames": {
                "type": "boolean",
                "default": false
              },
              "kick_members": {
                "type": "boolean",
                "default": false
              },
              "accept_members": {
                "type": "boolean",
                "default": false
              },
              "ban_members": {
                "type": "boolean",
                "default": false
              },
              "timeout_members": {
                "type": "boolean",
                "default": false
              },
              "send_messages": {
                "type": "boolean",
                "default": true
              },
              "attach_files": {
                "type": "boolean",
                "default": true
              },
              "embed_links": {
                "type": "boolean",
                "default": true
              },
              "use_emojis": {
                "type": "boolean",
                "default": true
              },
              "use_stickers": {
                "type": "boolean",
                "default": true
              },
              "use_gifs": {
                "type": "boolean",
                "default": true
              },
              "voice_connect": {
                "type": "boolean",
                "default": true
              },
              "voice_move_members": {
                "type": "boolean",
                "default": false
              },
              "administrator": {
                "type": "boolean",
                "default": false
              }
            },
            "default": {}
          }
        }
      },
      "default": []
    },
    "welcome_enabled": {
      "type": "boolean",
      "default": false
    },
    "welcome_message": {
      "type": "string"
    },
    "welcome_channel_id": {
      "type": "string"
    },
    "interactive_buttons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "profile_popup_config": {
      "type": "object",
      "properties": {
        "show_activity": {
          "type": "boolean",
          "default": true
        },
        "show_trophies": {
          "type": "boolean",
          "default": true
        },
        "show_xp": {
          "type": "boolean",
          "default": true
        },
        "show_level": {
          "type": "boolean",
          "default": true
        },
        "show_roles": {
          "type": "boolean",
          "default": true
        },
        "show_dm_input": {
          "type": "boolean",
          "default": true
        },
        "allow_reports": {
          "type": "boolean",
          "default": true
        },
        "show_custom_status": {
          "type": "boolean",
          "default": true
        },
        "show_badges": {
          "type": "boolean",
          "default": true
        },
        "show_friend_status": {
          "type": "boolean",
          "default": true
        }
      },
      "default": {}
    },
    "appearance_config": {
      "type": "object",
      "properties": {
        "allowed_themes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "custom_theme_bg_required": {
          "type": "boolean",
          "default": true
        },
        "max_custom_themes": {
          "type": "number",
          "default": 10
        },
        "min_boost_for_themes": {
          "type": "number",
          "default": 1
        },
        "min_boost_for_banner": {
          "type": "number",
          "default": 2
        },
        "min_boost_for_animated_icon": {
          "type": "number",
          "default": 1
        },
        "min_boost_for_custom_emojis": {
          "type": "number",
          "default": 1
        }
      },
      "default": {}
    },
    "invitation_config": {
      "type": "object",
      "properties": {
        "default_expiration": {
          "type": "string",
          "enum": [
            "never",
            "1h",
            "24h",
            "7d"
          ],
          "default": "never"
        },
        "allow_member_invites": {
          "type": "boolean",
          "default": false
        },
        "code_length": {
          "type": "number",
          "default": 8
        },
        "max_uses": {
          "type": "number",
          "default": 0
        },
        "require_approval": {
          "type": "boolean",
          "default": false
        }
      },
      "default": {}
    },
    "category_extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category_name": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}