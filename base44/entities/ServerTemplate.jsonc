{
  "name": "ServerTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du template/gabarit"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description du template"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Template par defaut applique aux nouveaux serveurs"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "voice",
              "announce",
              "forum",
              "category"
            ],
            "default": "text"
          },
          "topic": {
            "type": "string"
          },
          "is_nsfw": {
            "type": "boolean",
            "default": false
          },
          "slowmode_seconds": {
            "type": "number",
            "default": 0
          },
          "category_id": {
            "type": "string"
          },
          "permissions": {
            "type": "object",
            "properties": {
              "read": {
                "type": "string",
                "enum": [
                  "everyone",
                  "mods",
                  "admin"
                ],
                "default": "everyone"
              },
              "write": {
                "type": "string",
                "enum": [
                  "everyone",
                  "mods",
                  "admin"
                ],
                "default": "everyone"
              }
            },
            "default": {
              "read": "everyone",
              "write": "everyone"
            }
          },
          "settings": {
            "type": "object",
            "properties": {
              "visible": {
                "type": "boolean",
                "default": true
              },
              "send_messages": {
                "type": "boolean",
                "default": true
              },
              "embed_links": {
                "type": "boolean",
                "default": true
              },
              "add_reactions": {
                "type": "boolean",
                "default": true
              },
              "manage_messages": {
                "type": "boolean",
                "default": false
              },
              "read_history": {
                "type": "boolean",
                "default": true
              },
              "voice_connect": {
                "type": "boolean",
                "default": true
              },
              "voice_speak": {
                "type": "boolean",
                "default": true
              },
              "voice_move_members": {
                "type": "boolean",
                "default": false
              }
            },
            "default": {}
          }
        }
      },
      "default": [],
      "description": "Categories et salons par defaut du template"
    },
    "custom_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "permissions": {
            "type": "object",
            "properties": {
              "view_channels": {
                "type": "boolean",
                "default": true
              },
              "manage_channels": {
                "type": "boolean",
                "default": false
              },
              "manage_roles": {
                "type": "boolean",
                "default": false
              },
              "manage_emojis": {
                "type": "boolean",
                "default": false
              },
              "view_logs": {
                "type": "boolean",
                "default": false
              },
              "create_invite": {
                "type": "boolean",
                "default": true
              },
              "change_nicknames": {
                "type": "boolean",
                "default": false
              },
              "kick_members": {
                "type": "boolean",
                "default": false
              },
              "accept_members": {
                "type": "boolean",
                "default": false
              },
              "ban_members": {
                "type": "boolean",
                "default": false
              },
              "timeout_members": {
                "type": "boolean",
                "default": false
              },
              "send_messages": {
                "type": "boolean",
                "default": true
              },
              "attach_files": {
                "type": "boolean",
                "default": true
              },
              "embed_links": {
                "type": "boolean",
                "default": true
              },
              "use_emojis": {
                "type": "boolean",
                "default": true
              },
              "use_stickers": {
                "type": "boolean",
                "default": true
              },
              "use_gifs": {
                "type": "boolean",
                "default": true
              },
              "voice_connect": {
                "type": "boolean",
                "default": true
              },
              "voice_move_members": {
                "type": "boolean",
                "default": false
              },
              "administrator": {
                "type": "boolean",
                "default": false
              }
            },
            "default": {}
          }
        }
      },
      "default": [],
      "description": "Roles types et permissions globales du template"
    },
    "welcome_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Activer le message de bienvenue automatique par defaut"
    },
    "welcome_message": {
      "type": "string",
      "description": "Texte du message de bienvenue. Supporte {user}."
    },
    "welcome_channel_id": {
      "type": "string",
      "description": "ID du salon de bienvenue par defaut"
    },
    "interactive_buttons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Boutons interactifs par defaut"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}