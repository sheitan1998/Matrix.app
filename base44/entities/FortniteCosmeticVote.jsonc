{
  "name": "FortniteCosmeticVote",
  "type": "object",
  "properties": {
    "cosmetic_id": {
      "type": "string",
      "description": "ID du cosm\u00e9tique Fortnite"
    },
    "cosmetic_name": {
      "type": "string",
      "description": "Nom du cosm\u00e9tique (cache)"
    },
    "cosmetic_type": {
      "type": "string",
      "description": "Type du cosm\u00e9tique (outfit, pickaxe, backbling, emote, glider, wrap)"
    },
    "cosmetic_image": {
      "type": "string",
      "description": "URL de l'image du cosm\u00e9tique (cache)"
    },
    "cosmetic_rarity": {
      "type": "string",
      "description": "Raret\u00e9 du cosm\u00e9tique (cache)"
    },
    "vote_type": {
      "type": "string",
      "enum": [
        "fire",
        "love",
        "meh",
        "trash"
      ],
      "description": "Type de vote: fire (\ud83d\udd25), love (\ud83d\ude0d), meh (\ud83d\ude10), trash (\ud83d\udca9)"
    },
    "score": {
      "type": "number",
      "description": "Score pond\u00e9r\u00e9: fire=2, love=1, meh=-1, trash=-2"
    },
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur MATRIX"
    }
  },
  "required": [
    "cosmetic_id",
    "vote_type",
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}