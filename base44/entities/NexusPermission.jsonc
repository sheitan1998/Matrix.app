{
  "name": "NexusPermission",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Cl\u00e9 technique unique (ex: can_fly, manage_channels)"
    },
    "label": {
      "type": "string",
      "description": "Nom affich\u00e9 dans l'interface"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Description de la permission"
    },
    "category": {
      "type": "string",
      "default": "G\u00e9n\u00e9ral",
      "description": "Cat\u00e9gorie d'affichage (ex: G\u00e9n\u00e9ral, Membres, Messages, Vocal)"
    },
    "default_value": {
      "type": "boolean",
      "default": false,
      "description": "Valeur par d\u00e9faut pour les nouveaux r\u00f4les"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Permission active et visible dans la matrice des r\u00f4les"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "highlight": {
      "type": "boolean",
      "default": false,
      "description": "Mettre en \u00e9vidence cette permission (ex: administrateur)"
    }
  },
  "required": [
    "key",
    "label",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}