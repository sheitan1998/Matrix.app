{
  "name": "SlotSymbol",
  "type": "object",
  "properties": {
    "theme_key": {
      "type": "string",
      "description": "Cle du theme (classic, nature, enfer, paradis, savane, ovni)"
    },
    "symbol": {
      "type": "string",
      "description": "Emoji ou texte du symbole"
    },
    "image_url": {
      "type": "string",
      "default": "",
      "description": "URL de l'image (surcharge l'emoji si defini)"
    },
    "label": {
      "type": "string",
      "description": "Nom du symbole"
    },
    "color": {
      "type": "string",
      "default": "#ffffff",
      "description": "Couleur du symbole"
    },
    "glow": {
      "type": "string",
      "default": "#ffffff",
      "description": "Couleur du halo lumineux"
    },
    "mult": {
      "type": "number",
      "default": 2,
      "description": "Multiplicateur de base (legacy, utilise si mult_3/4/5 non definis)"
    },
    "mult_3": {
      "type": "number",
      "default": 2,
      "description": "Multiplicateur pour 3 symboles alignes"
    },
    "mult_4": {
      "type": "number",
      "default": 3,
      "description": "Multiplicateur pour 4 symboles alignes"
    },
    "mult_5": {
      "type": "number",
      "default": 4,
      "description": "Multiplicateur pour 5 symboles alignes"
    },
    "rare": {
      "type": "number",
      "default": 5,
      "description": "Poids dans le pool de tirage (plus eleve = plus frequent)"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Commun",
        "Rare",
        "\u00c9pique",
        "L\u00e9gendaire"
      ],
      "default": "Commun",
      "description": "Niveau de rarete du symbole"
    },
    "is_wild": {
      "type": "boolean",
      "default": false,
      "description": "Symbole Wild (remplace n'importe quel symbole)"
    },
    "is_text": {
      "type": "boolean",
      "default": false,
      "description": "Afficher comme texte (police gras)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Ordre d'affichage"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "theme_key",
    "symbol"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}