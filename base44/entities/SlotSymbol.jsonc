{
  "name": "SlotSymbol",
  "type": "object",
  "properties": {
    "theme_key": {
      "type": "string",
      "description": "Cle du theme (classic, nature, enfer, paradis, savane, ovni)"
    },
    "symbol": {
      "type": "string",
      "description": "Emoji ou texte du symbole"
    },
    "image_url": {
      "type": "string",
      "default": "",
      "description": "URL de l'image (surcharge l'emoji si defini)"
    },
    "label": {
      "type": "string",
      "description": "Nom du symbole"
    },
    "color": {
      "type": "string",
      "default": "#ffffff",
      "description": "Couleur du symbole"
    },
    "glow": {
      "type": "string",
      "default": "#ffffff",
      "description": "Couleur du halo lumineux"
    },
    "mult": {
      "type": "number",
      "default": 5,
      "description": "Multiplicateur de gain"
    },
    "rare": {
      "type": "number",
      "default": 5,
      "description": "Poids dans le pool de tirage (plus eleve = plus frequent)"
    },
    "is_wild": {
      "type": "boolean",
      "default": false,
      "description": "Symbole Wild (remplace n'importe quel symbole)"
    },
    "is_text": {
      "type": "boolean",
      "default": false,
      "description": "Afficher comme texte (police gras)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Ordre d'affichage"
    }
  },
  "required": [
    "theme_key",
    "symbol"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}