{
  "name": "AiConnector",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Identifiant du proprietaire du connecteur"
    },
    "provider": {
      "type": "string",
      "enum": [
        "webhook"
      ],
      "default": "webhook"
    },
    "name": {
      "type": "string",
      "description": "Nom du webhook choisi par l'utilisateur"
    },
    "webhook_url": {
      "type": "string",
      "description": "URL https du webhook (jamais renvoyee au client, acces serveur uniquement)"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "untested",
        "ok",
        "error"
      ],
      "default": "untested",
      "description": "Resultat du dernier envoi"
    },
    "last_error": {
      "type": "string",
      "description": "Dernier message d'erreur (affichage)"
    },
    "last_triggered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "provider",
    "name",
    "webhook_url"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
