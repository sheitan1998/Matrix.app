{
  "name": "MatrixShopCategory",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "enum": [
        "cosmetics",
        "trix",
        "nexus",
        "boosts",
        "subscriptions",
        "vip",
        "tickets",
        "other"
      ],
      "description": "Cle technique de la categorie (liee au champ shop_section des produits)"
    },
    "label": {
      "type": "string",
      "description": "Nom affiche de la categorie"
    },
    "description": {
      "type": "string",
      "description": "Description courte affichee sur la carte"
    },
    "icon": {
      "type": "string",
      "description": "Emoji ou URL de l'icone de la categorie"
    },
    "image_url": {
      "type": "string",
      "description": "URL du visuel de la carte (optionnel)"
    },
    "accent_color": {
      "type": "string",
      "default": "#a855f7",
      "description": "Couleur d'accent de la carte (hex)"
    },
    "cta_label": {
      "type": "string",
      "default": "Voir la cat\u00e9gorie",
      "description": "Libelle du bouton de la carte"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "key",
    "label"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}