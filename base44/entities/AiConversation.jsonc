{
  "name": "AiConversation",
  "type": "object",
  "properties": {
    "user_id": { "type": "string", "description": "Identifiant du proprietaire de la discussion" },
    "last_message_at": { "type": "string", "format": "date-time", "description": "Date du dernier message (tri de la liste)" },
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "creative",
        "code",
        "debate",
        "story",
        "image_prompt",
        "general"
      ],
      "default": "general"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": { "data.user_email": "{{user.email}}" },
    "read": { "$or": [ { "data.user_id": "{{user.id}}" }, { "data.user_email": "{{user.email}}" } ] },
    "update": { "$or": [ { "data.user_id": "{{user.id}}" }, { "data.user_email": "{{user.email}}" } ] },
    "delete": { "$or": [ { "data.user_id": "{{user.id}}" }, { "data.user_email": "{{user.email}}" } ] }
  }
}
