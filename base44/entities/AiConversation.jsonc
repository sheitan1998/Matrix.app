{
  "name": "AiConversation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email du proprietaire de la discussion"
    },
    "title": {
      "type": "string",
      "maxLength": 120,
      "description": "Titre genere automatiquement a partir du premier message"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date du dernier message (tri de la sidebar)"
    }
  },
  "required": [
    "user_email",
    "title"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}