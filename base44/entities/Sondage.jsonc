{
  "name": "Sondage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre du sondage"
    },
    "description": {
      "type": "string",
      "description": "Description ou question"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Choix de reponses"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active",
      "description": "Statut du sondage"
    },
    "category": {
      "type": "string",
      "default": "general",
      "description": "Categorie d'univers (general, youtube, twitch, nexus, casino, ai, outils, tuto-gaming)"
    },
    "is_proposal": {
      "type": "boolean",
      "default": false,
      "description": "Vrai si c'est une proposition d'idee utilisateur (non admin)"
    },
    "created_by_name": {
      "type": "string",
      "description": "Nom du createur"
    },
    "created_by_email": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "data.created_by_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.created_by_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}