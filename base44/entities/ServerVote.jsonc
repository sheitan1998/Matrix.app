{
  "name": "ServerVote",
  "type": "object",
  "properties": {
    "server_ad_id": {
      "type": "string",
      "description": "ID de l'annonce de serveur (legacy)"
    },
    "server_id": {
      "type": "string",
      "description": "ID du serveur (nouveau systeme annuaire)"
    },
    "user_email": {
      "type": "string"
    },
    "ip_address": {
      "type": "string",
      "description": "Adresse IP pour les votes non-connectes"
    },
    "last_voted_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "server_ad_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}