{
  "name": "SlotThemeConfig",
  "type": "object",
  "properties": {
    "theme_key": {
      "type": "string",
      "description": "Cle du theme (classic, nature, enfer, paradis, savane, ovni)"
    },
    "bg_image": {
      "type": "string",
      "default": "",
      "description": "URL de l'image de fond (surcharge celle par defaut du theme)"
    },
    "grid_width": {
      "type": "number",
      "default": 70,
      "description": "Largeur de la grille en pourcentage du conteneur"
    },
    "grid_height": {
      "type": "number",
      "default": 45,
      "description": "Hauteur de la grille en pourcentage du conteneur"
    },
    "grid_gap": {
      "type": "number",
      "default": 4,
      "description": "Espacement entre les symboles en pixels"
    },
    "grid_pos_x": {
      "type": "number",
      "default": 50,
      "description": "Position horizontale de la grille en pourcentage"
    },
    "grid_pos_y": {
      "type": "number",
      "default": 50,
      "description": "Position verticale de la grille en pourcentage"
    },
    "symbol_size": {
      "type": "number",
      "default": 28,
      "description": "Taille des symboles en pixels"
    },
    "control_pos_x": {
      "type": "number",
      "default": 50,
      "description": "Position horizontale des boutons en pourcentage"
    },
    "control_pos_y": {
      "type": "number",
      "default": 4,
      "description": "Position verticale des boutons depuis le bas en pourcentage"
    },
    "control_scale": {
      "type": "number",
      "default": 100,
      "description": "Echelle des boutons en pourcentage (50-200)"
    },
    "win_rate": {
      "type": "number",
      "default": 49,
      "description": "Taux de victoire en pourcentage (0-100)"
    },
    "button_styles": {
      "type": "object",
      "default": {},
      "description": "Configuration des styles et positions des boutons par theme (spin, auto, bet_minus, bet_plus, max_bet, paytable)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "theme_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}