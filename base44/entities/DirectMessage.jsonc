{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string",
      "description": "Email de l'expediteur"
    },
    "sender_name": {
      "type": "string",
      "description": "Nom de l'expediteur"
    },
    "sender_avatar": {
      "type": "string",
      "description": "Avatar de l'expediteur"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email du destinataire"
    },
    "recipient_name": {
      "type": "string",
      "description": "Nom du destinataire"
    },
    "recipient_avatar": {
      "type": "string",
      "description": "Avatar du destinataire"
    },
    "content": {
      "type": "string",
      "description": "Contenu du message"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "voice"
      ],
      "default": "text",
      "description": "Type de message (text ou voice)"
    },
    "file_url": {
      "type": "string",
      "description": "URL du fichier audio (messages vocaux)"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Statut de lecture"
    },
    "is_read_only": {
      "type": "boolean",
      "default": false,
      "description": "Fil de discussion en lecture seule (l'utilisateur ne peut pas repondre)"
    },
    "is_welcome_message": {
      "type": "boolean",
      "default": false,
      "description": "Message de bienvenue systeme"
    },
    "ticket_id": {
      "type": "string",
      "description": "ID du ticket de support associe (pour suppression a la fermeture du ticket)"
    }
  },
  "required": [
    "sender_email",
    "recipient_email",
    "content"
  ],
  "rls": {
    "create": {
      "data.sender_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}