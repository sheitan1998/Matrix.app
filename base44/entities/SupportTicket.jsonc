{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur"
    },
    "user_name": {
      "type": "string",
      "description": "Pseudo de l'utilisateur"
    },
    "user_avatar": {
      "type": "string",
      "description": "Avatar de l'utilisateur"
    },
    "subject": {
      "type": "string",
      "description": "Sujet du ticket"
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "account",
        "payment",
        "harassment",
        "creator_request",
        "affiliate_partner",
        "other"
      ],
      "default": "other",
      "description": "Categorie du ticket"
    },
    "program_type": {
      "type": "string",
      "enum": [
        "affiliate",
        "partner"
      ],
      "description": "Type de candidature (programme Affilies/Partenaires) - null pour les autres tickets"
    },
    "message": {
      "type": "string",
      "description": "Message detaille de l'utilisateur"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "description": "Statut du ticket"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Priorite du ticket"
    },
    "admin_response": {
      "type": "string",
      "description": "Reponse de l'admin (legacy)"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de reponse"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Verrouille le ticket en lecture seule (cloture)"
    },
    "creator_category": {
      "type": "string",
      "enum": [
        "mods",
        "fortnite_maps",
        "design",
        "other"
      ],
      "description": "Categorie de creation (pour les demandes de statut Createur)"
    },
    "portfolio_links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Liens vers le portfolio / plateformes du createur"
    },
    "creator_description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description des types de contenus crees"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_email",
    "subject",
    "message",
    "category"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}