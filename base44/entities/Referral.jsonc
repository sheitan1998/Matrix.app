{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string",
      "description": "Email de l'affili\u00e9/partenaire qui parraine"
    },
    "referrer_code": {
      "type": "string",
      "description": "Code d'affiliation utilis\u00e9 lors de l'inscription (param\u00e8tre ?ref=)"
    },
    "referred_email": {
      "type": "string",
      "description": "Email du filleul inscrit"
    },
    "referred_name": {
      "type": "string",
      "description": "Pseudo du filleul au moment de l'inscription"
    }
  },
  "required": [
    "referrer_email",
    "referred_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.referrer_email": "{{user.email}}"
        },
        {
          "data.referred_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}