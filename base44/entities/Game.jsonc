{
  "name": "Game",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du jeu"
    },
    "slug": {
      "type": "string",
      "description": "Slug URL unique"
    },
    "description": {
      "type": "string",
      "description": "Description courte du jeu"
    },
    "image_url": {
      "type": "string",
      "description": "Image de couverture (optionnel)"
    },
    "card_gradient": {
      "type": "string",
      "description": "Gradient CSS pour la carte"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}