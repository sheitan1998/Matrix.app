{
  "name": "FarmingSimPopup",
  "type": "object",
  "properties": {
    "popup_key": {
      "type": "string",
      "description": "Cle du pop-up (enclos, rendement, usines)"
    },
    "title": {
      "type": "string",
      "description": "Titre de la categorie ou sous-categorie"
    },
    "slug": {
      "type": "string",
      "description": "Slug URL unique"
    },
    "parent_slug": {
      "type": "string",
      "description": "Slug de la categorie parente (null pour les categories principales)"
    },
    "img": {
      "type": "string",
      "description": "URL de l'image principale (affiche de l'element)"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Images supplementaires (recettes, etapes de fabrication, details visuels)"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_standalone": {
      "type": "boolean",
      "default": false,
      "description": "Image autonome affichee directement sans categorie"
    },
    "game_slug": {
      "type": "string",
      "default": "farming-simulator-25"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "popup_key",
    "title",
    "slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}