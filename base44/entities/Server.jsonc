{
  "name": "Server",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon_emoji": {
      "type": "string"
    },
    "icon_url": {
      "type": "string"
    },
    "banner_color": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "visual_theme": {
      "type": "string",
      "enum": [
        "default",
        "ruby",
        "galaxy",
        "ocean",
        "forest",
        "neon",
        "gold",
        "midnight"
      ],
      "default": "default"
    },
    "theme": {
      "type": "string",
      "enum": [
        "gaming",
        "music",
        "tech",
        "sport",
        "art",
        "cinema",
        "humour",
        "news",
        "autre"
      ],
      "default": "autre"
    },
    "is_public": {
      "type": "boolean",
      "default": false
    },
    "server_type": {
      "type": "string",
      "enum": [
        "nexus",
        "discord"
      ],
      "default": "nexus",
      "description": "Type de serveur: Nexus (interne) ou Discord (externe)"
    },
    "discord_link": {
      "type": "string",
      "description": "Lien d'invitation Discord (si server_type = discord)"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "members_count": {
      "type": "number",
      "default": 1
    },
    "boosts": {
      "type": "number",
      "default": 0,
      "description": "Nombre de boosts Flash appliques au serveur (max 30)"
    },
    "invite_code": {
      "type": "string"
    },
    "invite_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'expiration du lien d'invitation (null = permanent)"
    },
    "allow_member_invites": {
      "type": "boolean",
      "default": false,
      "description": "Autoriser les membres a generer des liens d'invitation"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "voice",
              "announce",
              "forum",
              "category"
            ]
          },
          "topic": {
            "type": "string"
          },
          "is_nsfw": {
            "type": "boolean",
            "default": false
          },
          "slowmode_seconds": {
            "type": "number",
            "default": 0
          },
          "category_id": {
            "type": "string",
            "description": "ID de la categorie parente (null si aucun)"
          },
          "permissions": {
            "type": "object",
            "properties": {
              "read": {
                "type": "string",
                "enum": [
                  "everyone",
                  "mods",
                  "admin"
                ],
                "default": "everyone"
              },
              "write": {
                "type": "string",
                "enum": [
                  "everyone",
                  "mods",
                  "admin"
                ],
                "default": "everyone"
              }
            },
            "default": {
              "read": "everyone",
              "write": "everyone"
            }
          }
        }
      }
    },
    "custom_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}