{
  "name": "Server",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon_emoji": {
      "type": "string"
    },
    "icon_url": {
      "type": "string"
    },
    "banner_color": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "visual_theme": {
      "type": "string",
      "enum": [
        "default",
        "ruby",
        "galaxy",
        "ocean",
        "forest",
        "neon",
        "gold",
        "midnight"
      ],
      "default": "default"
    },
    "theme": {
      "type": "string",
      "enum": [
        "gaming",
        "music",
        "tech",
        "sport",
        "art",
        "cinema",
        "humour",
        "news",
        "autre"
      ],
      "default": "autre"
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "members_count": {
      "type": "number",
      "default": 1
    },
    "invite_code": {
      "type": "string"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "voice",
              "announce"
            ]
          }
        }
      }
    }
  },
  "required": [
    "name",
    "owner_email"
  ]
}