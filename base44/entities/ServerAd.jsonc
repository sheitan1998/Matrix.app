{
  "name": "ServerAd",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de l'annonce"
    },
    "description": {
      "type": "string",
      "description": "Description"
    },
    "discord_link": {
      "type": "string",
      "description": "Lien Discord"
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "server",
        "player"
      ],
      "default": "server",
      "description": "Type d'annonce: serveur ou recherche joueur"
    },
    "profile_image": {
      "type": "string",
      "description": "Photo de profil de l'annonce"
    },
    "cover_image": {
      "type": "string",
      "description": "Image de couverture de l'annonce"
    },
    "category": {
      "type": "string",
      "default": "",
      "description": "Categorie du serveur"
    },
    "additional_info": {
      "type": "string",
      "description": "Informations supplementaires du serveur"
    },
    "game": {
      "type": "string",
      "default": "",
      "description": "Jeu associe"
    },
    "rank_tier": {
      "type": "string",
      "default": "",
      "description": "Rank/niveau recherche"
    },
    "availability": {
      "type": "number",
      "default": 1,
      "description": "Niveau de disponibilite (1-5)"
    },
    "availability_hours": {
      "type": "string",
      "description": "Disponibilite en heures (ex: 18h-22h, 20h/semaine)"
    },
    "player_count_needed": {
      "type": "number",
      "default": 0,
      "description": "Nombre de joueurs recherches"
    },
    "votes": {
      "type": "number",
      "default": 0
    },
    "boosts": {
      "type": "number",
      "default": 0
    },
    "is_boosted": {
      "type": "boolean",
      "default": false
    },
    "boost_until": {
      "type": "string",
      "format": "date-time"
    },
    "server_icon": {
      "type": "string"
    },
    "players_count": {
      "type": "number",
      "default": 0
    },
    "max_players": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "description",
    "author_email"
  ],
  "rls": {
    "create": {
      "data.author_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}