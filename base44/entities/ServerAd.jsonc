{
  "name": "ServerAd",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de l'annonce"
    },
    "slug": {
      "type": "string",
      "description": "Slug URL unique du serveur"
    },
    "description": {
      "type": "string",
      "description": "Description"
    },
    "discord_link": {
      "type": "string",
      "description": "Lien Discord (serveur uniquement)"
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "server",
        "player"
      ],
      "default": "server",
      "description": "Type d'annonce: serveur ou recherche joueur"
    },
    "server_type": {
      "type": "string",
      "enum": [
        "nexus",
        "discord"
      ],
      "default": "nexus",
      "description": "Type de serveur: Nexus ou Discord"
    },
    "category_id": {
      "type": "string",
      "description": "ID de la categorie ServerCategory associee"
    },
    "category_slug": {
      "type": "string",
      "description": "Slug de la categorie (cache pour filtrage)"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Categories multiples associees au serveur"
    },
    "category_slugs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Slugs des categories multiples (cache pour filtrage)"
    },
    "games": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Jeux multiples associes au serveur"
    },
    "profile_image": {
      "type": "string",
      "description": "Photo de profil / logo du serveur"
    },
    "cover_image": {
      "type": "string",
      "description": "Image de couverture / banniere du serveur"
    },
    "logo_url": {
      "type": "string",
      "description": "URL du logo du serveur"
    },
    "banner_url": {
      "type": "string",
      "description": "URL de la banniere du serveur"
    },
    "category": {
      "type": "string",
      "default": "",
      "description": "Categorie du serveur (legacy texte libre)"
    },
    "game": {
      "type": "string",
      "default": "",
      "description": "Jeu associe"
    },
    "ip": {
      "type": "string",
      "description": "Adresse IP du serveur Nexus"
    },
    "port": {
      "type": "number",
      "default": 0,
      "description": "Port du serveur Nexus"
    },
    "webhook_api_key": {
      "type": "string",
      "description": "Cle API webhook pour le vote Nexus (cote serveur uniquement)"
    },
    "discord_server_id": {
      "type": "string",
      "description": "ID du serveur Discord"
    },
    "additional_info": {
      "type": "string",
      "description": "Informations supplementaires du serveur"
    },
    "rank_tier": {
      "type": "string",
      "default": "",
      "description": "Rank/niveau recherche"
    },
    "availability": {
      "type": "number",
      "default": 1,
      "description": "Niveau de disponibilite (1-5)"
    },
    "availability_hours": {
      "type": "string",
      "description": "Disponibilite en heures (ex: 18h-22h, 20h/semaine)"
    },
    "player_count_needed": {
      "type": "number",
      "default": 0,
      "description": "Nombre de joueurs recherches"
    },
    "player_pseudo": {
      "type": "string",
      "description": "Nom ou pseudo du joueur (optionnel)"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'expiration de l'annonce (1 heure apres creation)"
    },
    "votes": {
      "type": "number",
      "default": 0
    },
    "votes_month": {
      "type": "number",
      "default": 0,
      "description": "Votes du mois en cours (reset mensuel)"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "Nombre total de clics (visites de fiche + votes)"
    },
    "clicks_month": {
      "type": "number",
      "default": 0,
      "description": "Clics du mois en cours (reset mensuel)"
    },
    "api_key": {
      "type": "string",
      "description": "Cle API secrete unique du serveur (Web API publique)"
    },
    "boosts": {
      "type": "number",
      "default": 0
    },
    "is_boosted": {
      "type": "boolean",
      "default": false
    },
    "boost_until": {
      "type": "string",
      "format": "date-time"
    },
    "server_icon": {
      "type": "string"
    },
    "players_count": {
      "type": "number",
      "default": 0
    },
    "max_players": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "description",
    "author_email"
  ],
  "rls": {
    "create": {
      "data.author_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}