{
  "name": "VoiceRoom",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "server_id": {
      "type": "string",
      "description": "ID du serveur (si salon vocal de serveur)"
    },
    "channel_id": {
      "type": "string",
      "description": "ID du canal vocal (si salon vocal de serveur)"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "micOn": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "default": [],
      "description": "Liste des participants connectes au salon vocal"
    },
    "participants_count": {
      "type": "number",
      "default": 1
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {},
    "update": {},
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}