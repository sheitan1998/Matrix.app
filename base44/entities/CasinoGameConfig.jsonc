{
  "name": "CasinoGameConfig",
  "type": "object",
  "properties": {
    "game_key": {
      "type": "string",
      "enum": [
        "scratch",
        "wheel"
      ],
      "description": "Cle du jeu de casino (scratch = tickets a gratter, wheel = roue de la fortune)"
    },
    "title": {
      "type": "string",
      "description": "Titre affiche aux joueurs"
    },
    "title_image": {
      "type": "string",
      "description": "URL de l'image graphique de titre (remplace le texte si defini)"
    },
    "title_image_scale": {
      "type": "number",
      "default": 100,
      "description": "Echelle de l'image de titre en pourcentage (50-200, 100 = taille par defaut)"
    },
    "title_image_pos_x": {
      "type": "number",
      "default": 50,
      "description": "Position horizontale de l'image de titre en pourcentage (0-100, 50 = centre)"
    },
    "title_image_pos_y": {
      "type": "number",
      "default": 50,
      "description": "Position verticale de l'image de titre en pourcentage (0-100, 50 = centre)"
    },
    "title_style": {
      "type": "object",
      "properties": {
        "font": {
          "type": "string",
          "default": "Inter",
          "description": "Police du titre"
        },
        "size": {
          "type": "number",
          "default": 18,
          "description": "Taille du titre en px"
        },
        "color_style": {
          "type": "string",
          "enum": [
            "gradient",
            "solid",
            "neon"
          ],
          "default": "gradient"
        },
        "color": {
          "type": "string",
          "default": "#00ffff",
          "description": "Couleur principale du titre"
        },
        "color2": {
          "type": "string",
          "default": "#ff00ff",
          "description": "Couleur secondaire (pour le degrade)"
        }
      },
      "default": {},
      "description": "Style typographique du titre"
    },
    "subtitle": {
      "type": "string",
      "description": "Sous-titre affiche sous le titre du jeu"
    },
    "description": {
      "type": "string",
      "description": "Description affichee aux joueurs"
    },
    "description_long": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description longue / banniere de presentation affichee aux joueurs"
    },
    "info_message": {
      "type": "string",
      "description": "Message d'information affiche aux joueurs (ex: conditions, astuces)"
    },
    "rules": {
      "type": "string",
      "description": "Regles affichees aux joueurs (texte libre)"
    },
    "banner_image": {
      "type": "string",
      "description": "URL de la banniere visuelle du jeu"
    },
    "icon": {
      "type": "string",
      "description": "Emoji ou URL de l'icone du jeu"
    },
    "center_icon": {
      "type": "string",
      "description": "URL ou emoji de l'icone centrale de la roue (wheel uniquement)"
    },
    "background_image": {
      "type": "string",
      "description": "URL de l'image de fond de la page de jeu"
    },
    "card_background_image": {
      "type": "string",
      "description": "URL de l'image de fond (cadre) du ticket a gratter"
    },
    "background_color": {
      "type": "string",
      "default": "#0a050f",
      "description": "Couleur de fond de la page de jeu (utilisee si pas d'image de fond)"
    },
    "background_scale": {
      "type": "number",
      "default": 100,
      "description": "Echelle fixe de l'image de fond en pourcentage (100 = taille naturelle, cover si 0)"
    },
    "background_pos_x": {
      "type": "number",
      "default": 50,
      "description": "Position horizontale de l'image de fond en pourcentage (0-100, 50 = centre)"
    },
    "background_pos_y": {
      "type": "number",
      "default": 50,
      "description": "Position verticale de l'image de fond en pourcentage (0-100, 50 = centre)"
    },
    "wheel_border": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "default": 4,
          "description": "Epaisseur du contour exterieur de la roue en px"
        },
        "style": {
          "type": "string",
          "enum": [
            "solid",
            "neon",
            "gradient"
          ],
          "default": "solid",
          "description": "Style du contour (uni, neon lumineux ou degrade)"
        },
        "color": {
          "type": "string",
          "default": "#a855f7",
          "description": "Couleur principale du contour"
        },
        "color2": {
          "type": "string",
          "default": "#00ffff",
          "description": "Couleur secondaire (pour le degrade ou le halo neon)"
        },
        "image": {
          "type": "string",
          "default": "",
          "description": "URL d'une image de contour (surcharge la couleur si definie)"
        }
      },
      "default": {},
      "description": "Configuration du contour exterieur de la roue"
    },
    "wheel_scale": {
      "type": "number",
      "default": 100,
      "description": "Echelle de la roue en pourcentage (50-200, 100 = taille par defaut)"
    },
    "wheel_pos_x": {
      "type": "number",
      "default": 50,
      "description": "Decalage horizontal de la roue en pourcentage (0-100, 50 = centre)"
    },
    "wheel_pos_y": {
      "type": "number",
      "default": 50,
      "description": "Decalage vertical de la roue en pourcentage (0-100, 50 = centre)"
    },
    "ticket_price": {
      "type": "number",
      "default": 10000,
      "description": "Prix d'achat d'un ticket a gratter (jetons)"
    },
    "spin_cost": {
      "type": "number",
      "default": 20000,
      "description": "Cout d'un lancer supplementaire de la roue (jetons)"
    },
    "win_rate": {
      "type": "number",
      "default": 30,
      "description": "Taux de victoire global en pourcentage (0-100), utilise comme fallback"
    },
    "scratch_mode_3_win_rate": {
      "type": "number",
      "default": 30,
      "description": "Taux de victoire (%) pour le mode 3 symboles identiques (0-100)"
    },
    "scratch_mode_5_win_rate": {
      "type": "number",
      "default": 15,
      "description": "Taux de victoire (%) pour le mode 5 symboles identiques (0-100)"
    },
    "scratch_symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant unique du symbole"
          },
          "icon": {
            "type": "string",
            "description": "Emoji ou URL de l'image du symbole"
          },
          "label": {
            "type": "string",
            "description": "Nom affiche du symbole"
          }
        }
      },
      "default": [],
      "description": "Symboles personnalises utilises dans la grille de grattage (min 3)"
    },
    "reset_hour_utc": {
      "type": "number",
      "default": 12,
      "description": "Heure UTC de reset quotidien du lancer/ticket gratuit (0-23)"
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "description": "Emoji ou URL de l'icone de la recompense"
          },
          "icon_size": {
            "type": "number",
            "default": 36,
            "description": "Taille de l'icone en px sur le segment"
          },
          "icon_rotation": {
            "type": "number",
            "default": 0,
            "description": "Angle de rotation de l'icone en degres"
          },
          "bg_color": {
            "type": "string",
            "default": "",
            "description": "Couleur de fond du segment (surcharge la couleur par defaut)"
          },
          "bg_image": {
            "type": "string",
            "default": "",
            "description": "URL d'une image de fond du segment (surcharge la couleur)"
          },
          "amount": {
            "type": "number",
            "default": 0
          },
          "weight": {
            "type": "number",
            "default": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "lose",
              "tokens",
              "trix",
              "relance"
            ]
          }
        }
      },
      "default": [],
      "description": "Configuration des recompenses (poids relatifs, montants, types, icones, taille, rotation, fond de segment)"
    }
  },
  "required": [
    "game_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}