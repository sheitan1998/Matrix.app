{
  "name": "GameComment",
  "type": "object",
  "properties": {
    "quest_id": {
      "type": "string",
      "description": "ID de la quete (optionnel)"
    },
    "wiki_entry_id": {
      "type": "string",
      "description": "ID de l'entree wiki (optionnel)"
    },
    "parent_id": {
      "type": "string",
      "description": "ID du commentaire parent pour les reponses"
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "author_email",
    "content"
  ],
  "rls": {
    "create": {
      "data.author_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "data.author_email": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}