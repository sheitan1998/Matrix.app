{
  "name": "GameServer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "game": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "members_count": {
      "type": "number",
      "default": 0
    },
    "platform": {
      "type": "string",
      "enum": [
        "discord",
        "pc",
        "playstation",
        "xbox",
        "mobile"
      ],
      "default": "discord"
    },
    "invite_link": {
      "type": "string"
    },
    "votes": {
      "type": "number",
      "default": 0
    },
    "boosts": {
      "type": "number",
      "default": 0
    },
    "banner_url": {
      "type": "string"
    },
    "icon_emoji": {
      "type": "string",
      "default": "\ud83c\udfae"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}