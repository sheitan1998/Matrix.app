{
  "name": "Listing",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "vetements_femme",
        "vetements_homme",
        "vetements_enfant",
        "chaussures",
        "accessoires",
        "sport",
        "maison",
        "electronique",
        "livres",
        "autre"
      ],
      "default": "autre"
    },
    "size": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "neuf_avec_etiquette",
        "neuf_sans_etiquette",
        "tres_bon_etat",
        "bon_etat",
        "satisfaisant"
      ],
      "default": "tres_bon_etat"
    },
    "color": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seller_email": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_avatar": {
      "type": "string"
    },
    "is_sold": {
      "type": "boolean",
      "default": false
    },
    "is_boosted": {
      "type": "boolean",
      "default": false
    },
    "boost_until": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "likes": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "price",
    "seller_email"
  ],
  "rls": {
    "create": {
      "data.seller_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}