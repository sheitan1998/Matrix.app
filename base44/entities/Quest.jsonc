{
  "name": "Quest",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "game_slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "quete",
        "debutant",
        "classe",
        "metier",
        "progression",
        "donjon",
        "connaissance",
        "faq"
      ],
      "default": "quete"
    },
    "extension": {
      "type": "string",
      "description": "Extension ou version du jeu"
    },
    "zone": {
      "type": "string",
      "description": "Zone geographique"
    },
    "level_min": {
      "type": "number",
      "default": 0
    },
    "level_max": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "prerequisites": {
      "type": "string"
    },
    "npc_name": {
      "type": "string",
      "description": "Nom du PNJ donneur de quete"
    },
    "npc_location": {
      "type": "string",
      "description": "Localisation du PNJ"
    },
    "coordinates": {
      "type": "string",
      "description": "Coordonnees de position"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "dialogues": {
      "type": "string",
      "description": "Dialogues utiles avec les PNJ"
    },
    "objectives": {
      "type": "string",
      "description": "Objectifs de la quete"
    },
    "combats": {
      "type": "string",
      "description": "Informations sur les combats eventuels"
    },
    "rewards": {
      "type": "string"
    },
    "tips": {
      "type": "string"
    },
    "map_info": {
      "type": "string"
    },
    "linked_quests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quest_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "image_url": {
      "type": "string",
      "description": "Emplacement pour image (droits requis)"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "facile",
        "moyen",
        "difficile"
      ],
      "default": "facile"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "game_id",
    "game_slug",
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}