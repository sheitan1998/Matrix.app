{
  "name": "ShopSubscriptionPlan",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Cle technique de l'abonnement (custom_bg, vote_auto, vip_cooldown)"
    },
    "label": {
      "type": "string",
      "description": "Nom affiche dans la boutique"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Description courte affichee sur la carte"
    },
    "price_cents": {
      "type": "number",
      "default": 299,
      "description": "Prix mensuel en centimes d'euro"
    },
    "duration_days": {
      "type": "number",
      "default": 30,
      "description": "Duree d'acces accordee en jours a chaque paiement"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Abonnement visible et achetable"
    },
    "badge": {
      "type": "string",
      "description": "Badge affiche sur la carte (optionnel)"
    },
    "visual": {
      "type": "string",
      "description": "Visuel de la carte : URL d'image ou emoji (optionnel, remplace l'icone par defaut)"
    },
    "perks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Avantages listes sur la carte"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "key",
    "label"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}