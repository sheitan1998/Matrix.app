{
  "name": "NexusGlobalExtension",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Cl\u00e9 technique unique"
    },
    "name": {
      "type": "string",
      "description": "Nom affich\u00e9"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "category": {
      "type": "string",
      "default": "G\u00e9n\u00e9ral",
      "description": "Cat\u00e9gorie de l'extension (ex: Gaming, Musique, Tech)"
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "Configuration de l'extension"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "key",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}