{
  "name": "UserCosmetic",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "rarity": {
      "type": "string"
    },
    "is_equipped": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email",
    "item_id",
    "category"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}