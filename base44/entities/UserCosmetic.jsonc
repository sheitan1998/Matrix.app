{
  "name": "UserCosmetic",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "rarity": {
      "type": "string"
    },
    "is_equipped": {
      "type": "boolean",
      "default": false
    },
    "video_url": {
      "type": "string",
      "description": "URL de la video d'animation (copiee depuis l'item a l'achat)"
    },
    "preview_image": {
      "type": "string",
      "description": "URL de l'image de preview (pour profile_cover)"
    },
    "anim_config": {
      "type": "object",
      "properties": {
        "scale": {
          "type": "number",
          "default": 1.15
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "offset_x": {
          "type": "number",
          "default": 0
        },
        "offset_y": {
          "type": "number",
          "default": 0
        },
        "mask_radius": {
          "type": "number",
          "default": 0.5
        }
      },
      "default": {},
      "description": "Configuration d'affichage copiee depuis le MatrixShopItem a l'achat"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_email",
    "item_id",
    "category"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}