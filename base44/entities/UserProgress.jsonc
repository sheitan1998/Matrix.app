{
  "name": "UserProgress",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "total_xp": {
      "type": "number",
      "default": 0
    },
    "coins": {
      "type": "number",
      "default": 500
    },
    "prestige": {
      "type": "number",
      "default": 0
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "unlocked_rewards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "stats": {
      "type": "object",
      "properties": {},
      "default": {}
    },
    "missions": {
      "type": "object",
      "properties": {},
      "default": {}
    },
    "last_xp_gains": {
      "type": "object",
      "properties": {},
      "default": {}
    },
    "equipped": {
      "type": "object",
      "properties": {},
      "default": {}
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}