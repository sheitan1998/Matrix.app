{
  "name": "UserProgress",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "pseudo": {
      "type": "string",
      "description": "Pseudo du joueur pour affichage leaderboard"
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "total_xp": {
      "type": "number",
      "default": 0
    },
    "coins": {
      "type": "number",
      "default": 500
    },
    "prestige": {
      "type": "number",
      "default": 0
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "claimed_achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "unlocked_rewards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "stats": {
      "type": "object",
      "properties": {},
      "default": {}
    },
    "missions": {
      "type": "object",
      "properties": {},
      "default": {}
    },
    "last_xp_gains": {
      "type": "object",
      "properties": {},
      "default": {}
    },
    "equipped": {
      "type": "object",
      "properties": {},
      "default": {}
    },
    "xp_boosters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "multiplier": {
            "type": "number"
          },
          "duration_hours": {
            "type": "number"
          },
          "purchased_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Boosters XP achetes en boutique (inventaire)"
    },
    "active_xp_boost": {
      "type": "object",
      "properties": {
        "multiplier": {
          "type": "number"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "booster_id": {
          "type": "string"
        }
      },
      "default": null,
      "description": "Booster XP actuellement actif (null si aucun)"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}