{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "mention",
        "role_assigned",
        "sport_event",
        "new_message",
        "invite",
        "twitch_live",
        "friend_request",
        "friend_accepted"
      ],
      "default": "mention"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": "string"
    },
    "server_id": {
      "type": "string"
    },
    "channel_id": {
      "type": "string"
    },
    "related_user_id": {
      "type": "string",
      "description": "ID de l'utilisateur li\u00e9 (auteur de la demande d'ami)"
    },
    "related_user_name": {
      "type": "string",
      "description": "Nom affich\u00e9 de l'utilisateur li\u00e9"
    }
  },
  "required": [
    "user_email",
    "type",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}