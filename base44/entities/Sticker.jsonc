{
  "name": "Sticker",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du sticker"
    },
    "pack": {
      "type": "string",
      "default": "Default",
      "description": "Nom du pack de stickers"
    },
    "image_url": {
      "type": "string",
      "description": "URL publique de l'image du sticker"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Sticker visible dans le picker"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "image_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}