{
  "name": "VideoProject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "timeline_data": {
      "type": "object",
      "properties": {},
      "default": {}
    },
    "thumbnail_url": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "resolution": {
      "type": "string",
      "default": "1080p"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "editing",
        "exported"
      ],
      "default": "draft"
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.owner_email": "{{user.email}}"
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}