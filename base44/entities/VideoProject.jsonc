{
  "name": "VideoProject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string",
      "description": "Identifiant de l'utilisateur propri\u00e9taire du projet (isolation stricte)"
    },
    "timeline_data": {
      "type": "object",
      "properties": {},
      "default": {}
    },
    "thumbnail_url": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "resolution": {
      "type": "string",
      "default": "1080p"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "editing",
        "exported"
      ],
      "default": "draft"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}