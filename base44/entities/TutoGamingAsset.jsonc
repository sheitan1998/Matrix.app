{
  "name": "TutoGamingAsset",
  "type": "object",
  "properties": {
    "asset_key": {
      "type": "string",
      "description": "Cle unique de l'asset (ex: fortnite_banner, game_farming_simulator_25, game_fortnite)"
    },
    "label": {
      "type": "string",
      "description": "Libelle affiche dans l'admin"
    },
    "category": {
      "type": "string",
      "enum": [
        "banner",
        "game_thumbnail",
        "poster",
        "illustration"
      ],
      "default": "illustration",
      "description": "Type d'asset visuel"
    },
    "image_url": {
      "type": "string",
      "description": "URL de l'image (upload public ou URL externe)"
    },
    "title": {
      "type": "string",
      "description": "Titre dynamique associe a l'asset (optionnel)"
    },
    "subtitle": {
      "type": "string",
      "description": "Sous-titre dynamique associe (optionnel)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Description dynamique associee (optionnel)"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "asset_key",
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}