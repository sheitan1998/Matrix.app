{
  "name": "MatrixShopItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du produit"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "badge",
        "frame",
        "animated_frame",
        "title",
        "animated_title",
        "pseudo_effect",
        "title_effect",
        "light_effect",
        "avatar_animation",
        "decoration",
        "exclusive"
      ],
      "default": "badge",
      "description": "Categorie du cosmetique"
    },
    "price_trix": {
      "type": "number",
      "default": 0
    },
    "icon": {
      "type": "string",
      "description": "Emoji ou URL image"
    },
    "preview_image": {
      "type": "string"
    },
    "video_url": {
      "type": "string",
      "description": "URL de la video d'animation (pour avatar_animation, format MP4/WebM sur fond noir)"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "rare",
        "epic",
        "legendary"
      ],
      "default": "common"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "category",
    "price_trix"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}