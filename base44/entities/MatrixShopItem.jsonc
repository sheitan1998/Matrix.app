{
  "name": "MatrixShopItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du produit"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "badge",
        "avatar_animation",
        "profile_cover"
      ],
      "default": "badge",
      "description": "Categorie du cosmetique"
    },
    "price_trix": {
      "type": "number",
      "default": 0,
      "description": "Prix en Trix (1 Trix = 0.01\u20ac)"
    },
    "price_euros": {
      "type": "number",
      "default": 0,
      "description": "Prix en euros"
    },
    "icon": {
      "type": "string",
      "description": "Emoji ou URL image"
    },
    "preview_image": {
      "type": "string"
    },
    "video_url": {
      "type": "string",
      "description": "URL de la video d'animation (pour avatar_animation, format MP4/WebM sur fond noir)"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "rare",
        "epic",
        "legendary"
      ],
      "default": "common"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "stripe_product_id": {
      "type": "string",
      "description": "ID produit Stripe (auto-cree)"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "ID prix Stripe (auto-cree)"
    },
    "anim_config": {
      "type": "object",
      "properties": {
        "scale": {
          "type": "number",
          "default": 1.15,
          "description": "Echelle du conteneur video (1.15 = 115% de l'avatar)"
        },
        "width": {
          "type": "number",
          "description": "Largeur en px (override l'echelle si defini)"
        },
        "height": {
          "type": "number",
          "description": "Hauteur en px (override l'echelle si defini)"
        },
        "offset_x": {
          "type": "number",
          "default": 0,
          "description": "Decalage horizontal en px"
        },
        "offset_y": {
          "type": "number",
          "default": 0,
          "description": "Decalage vertical en px"
        },
        "mask_radius": {
          "type": "number",
          "default": 0.5,
          "description": "Rayon du trou central transparent (0-1, 0.5 = taille de l'avatar)"
        }
      },
      "default": {},
      "description": "Configuration d'affichage de l'animation (avatar_animation)"
    }
  },
  "required": [
    "name",
    "category",
    "price_trix"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}